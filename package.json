{
  "name": "resume-template",
  "version": "1.0.0",
  "description": "One-page, ATS-readable LaTeX resume rendered from a JSON Resume file",
  "license": "MIT",
  "bin": {
    "resume-template": "bin/resume-template.mjs"
  },
  "files": [
    "bin",
    "lib",
    "templates"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.mjs"
  },
  "scripts": {
    "pdf": "node bin/resume-template.mjs resume.json",
    "test": "vitest run test/render.test.mjs test/build.test.mjs",
    "test:pdf": "vitest run test/pdf.test.mjs",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@jsonresume/schema": "1.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.6.0"
}
